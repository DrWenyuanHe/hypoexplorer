// Split the FGSEA pathways block OUT of each macaque track bundle into a sibling
// track_<id>.pathways.js, and emit a dataset-level pathways_index.js (the union of
// gs_names) for the cross-dataset pathway autocomplete. The track bundle keeps
// {meta,qc,de,cpm} only — so the cross-dataset gene query and single-track loads
// no longer pay the FGSEA tax. (migrate_macaque_bundles can't re-run — legacy
// pop_<id>.js are gone — so this patches the committed bundles in place.)
//
// Idempotent: a track whose pathways were already split (no `pathways` key) is
// left as-is; its existing sibling is preserved.
//
// Run: tsx scripts/split_macaque_pathways.mts
import { readFileSync, writeFileSync, readdirSync, existsSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const BUNDLE_DIR = resolve(ROOT, 'public', 'datasets', 'macaque_snrna');
const DSID = 'MACAQUE_SNRNA';

const trackFiles = readdirSync(BUNDLE_DIR).filter((f) => /^track_.+(?<!\.pathways)\.js$/.test(f));
const names = new Set<string>();
let split = 0, already = 0;

for (const file of trackFiles) {
  const trackId = file.replace(/^track_(.+)\.js$/, '$1');
  const raw = readFileSync(resolve(BUNDLE_DIR, file), 'utf8');
  const m = raw.match(/^([\s\S]*?)\nvar (\w+) = ([\s\S]*?);\s*$/);
  if (!m) throw new Error(`${file}: unexpected bundle format`);
  const [, header, key, jsonStr] = m;
  const obj = JSON.parse(jsonStr) as { pathways?: Record<string, Array<{ pathway: string }>> | null };

  const pathways = obj.pathways;
  if (pathways) {
    for (const arr of Object.values(pathways)) for (const p of arr) names.add(p.pathway);
    // Write the sibling and drop pathways from the track bundle.
    writeFileSync(resolve(BUNDLE_DIR, `track_${trackId}.pathways.js`),
      `// AUTO-GENERATED by scripts/split_macaque_pathways.mts — do not edit\nvar HX_${DSID}_${trackId.toUpperCase()}_PATH = ${JSON.stringify(pathways)};\n`);
    obj.pathways = undefined;
    delete obj.pathways;
    writeFileSync(resolve(BUNDLE_DIR, file), `${header}\nvar ${key} = ${JSON.stringify(obj)};\n`);
    split++;
  } else {
    // Already split — fold its sibling's names into the index if present.
    const sib = resolve(BUNDLE_DIR, `track_${trackId}.pathways.js`);
    if (existsSync(sib)) {
      const sm = readFileSync(sib, 'utf8').match(/=\s*([\s\S]*?);\s*$/);
      if (sm) for (const arr of Object.values(JSON.parse(sm[1]) as Record<string, Array<{ pathway: string }>>)) for (const p of arr) names.add(p.pathway);
    }
    already++;
  }
}

const sorted = [...names].sort();
writeFileSync(resolve(BUNDLE_DIR, 'pathways_index.js'),
  `// AUTO-GENERATED by scripts/split_macaque_pathways.mts — do not edit\nvar HX_${DSID}_PATHIDX = ${JSON.stringify(sorted)};\n`);

console.log(`split_macaque_pathways: ${split} split, ${already} already-split / ${trackFiles.length} tracks`);
console.log(`  pathways_index.js: ${sorted.length} distinct gs_names`);
