import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync } from 'node:fs';
import type { QualityAssessment } from '../src/data/qualityChecks';

const folder = 'data/quality/advancement-2026-09-05';
const read = (path: string) => JSON.parse(readFileSync(path, 'utf8'));
const baseline = read(`${folder}/baseline.json`);
const current = read('data/quality/assessments.generated.json');
const author = read('data/author-validation/validation-records.generated.json');
const replay = read('data/internal-qc/advancement-2026-09-05/normalization-evidence.json');
type Row = { datasetId: string; accession: string; internalQc: QualityAssessment; authorConcordance: QualityAssessment };
const count = (rows: Row[], key: 'internalQc' | 'authorConcordance') => Object.fromEntries(['pass', 'review', 'fail', 'not_assessed', 'not_applicable'].map(status => [status, rows.filter(row => row[key].status === status).length]));
const oldById = new Map<string, Row>(baseline.quality.records.map((row: Row) => [row.datasetId, row]));
const currentScope: Row[] = baseline.quality.records.map((before: Row) => {
  const after = current.records.find((row: Row) => row.datasetId === before.datasetId);
  if (!after) throw new Error(`Original dataset missing: ${before.datasetId}`);
  return after;
});
const authorById = new Map<string, (typeof author.records)[number]>(author.records.map((row: { datasetId: string }) => [row.datasetId, row]));
const records = currentScope.map((row: Row) => {
  const old = oldById.get(row.datasetId)!;
  const source = authorById.get(row.datasetId)!;
  const progressed = (key: 'internalQc' | 'authorConcordance') => row[key].checks.filter(check => check.status === 'pass' && old[key].checks.find(before => before.id === check.id)?.status !== 'pass').map(check => check.label);
  const pending = (key: 'internalQc' | 'authorConcordance') => row[key].checks.filter(check => check.required !== false && !['pass', 'not_applicable'].includes(check.status)).map(check => ({ check: check.label, status: check.status, note: check.note }));
  return { datasetId: row.datasetId, accession: row.accession, before: { internalQc: old.internalQc.status, authorConcordance: old.authorConcordance.status }, after: { internalQc: row.internalQc.status, authorConcordance: row.authorConcordance.status }, newPassingChecks: { internalQc: progressed('internalQc'), authorConcordance: progressed('authorConcordance') }, remainingChecks: { internalQc: pending('internalQc'), authorConcordance: pending('authorConcordance') }, authorReferenceScope: row.authorConcordance.scope, authorAvailability: source.verification.resultAvailability, authorNextStep: source.verification.nextStep, comparisonRecorded: Boolean(source.directComparison) };
});
const summary = { datasets: records.length, before: { internalQc: count(baseline.quality.records, 'internalQc'), authorConcordance: count(baseline.quality.records, 'authorConcordance'), directComparisons: baseline.validation.records.filter((row: { directComparison: unknown }) => row.directComparison).length }, after: { internalQc: count(currentScope, 'internalQc'), authorConcordance: count(currentScope, 'authorConcordance'), directComparisons: author.records.filter((row: { datasetId: string; directComparison: unknown }) => oldById.has(row.datasetId) && row.directComparison).length }, datasetsWithNewPassingChecks: records.filter(row => row.newPassingChecks.internalQc.length || row.newPassingChecks.authorConcordance.length).length };
const dependencies = ['data/quality/assessments.generated.json', 'data/author-validation/validation-records.generated.json', 'data/author-validation/additional-comparison-specs.json', 'data/internal-qc/advancement-2026-09-05/normalization-evidence.json'].map(path => ({ path, sha256: createHash('sha256').update(readFileSync(path)).digest('hex') }));
const clean = (value: string) => value.replace(/[|\t\r\n]/g, ' ');
const md = ['# Dataset verification advancement', '', 'Date: 2026-09-05. All 145 dataset records were assessed. Work was divided across an internal-QC agent, an existing-comparison agent, and two author-source groups. The existing-comparison agent independently reviewed the new source extractions and QC replay changes. No registered count matrix, DE result or analysis method was replaced.', '', '| Measure | Before | After |', '|---|---:|---:|', `| Complete internal QC passes | ${summary.before.internalQc.pass} | ${summary.after.internalQc.pass} |`, `| Author-concordance passes | ${summary.before.authorConcordance.pass} | ${summary.after.authorConcordance.pass} |`, `| Datasets with shared numerical author comparison | ${summary.before.directComparisons} | ${summary.after.directComparisons} |`, `| Author concordance not assessed | ${summary.before.authorConcordance.not_assessed} | ${summary.after.authorConcordance.not_assessed} |`, '', 'A complete internal-QC pass requires all applicable checks, including source integrity and biological replication. Reproducing the registered calculation alone does not establish those independent facts. Author concordance now uses alternative correlation or matched-gene direction criteria with required cohort, contrast, identifier, effect-definition and coverage checks. The policy-only effect on unchanged evidence is recorded separately in ../round2-2026-09-05/policy-only-impact.json. Magnitudes, P values and FDR are contextual. Selected-list passes retain their selected scope; separate author-method reconstructions never substitute for registered outputs.', '', 'The retained supplements include newly recovered pig immune-activation and zebrafish fluoxetine evidence. The pig results cover a different factorial effect; all 86 matched fluoxetine selected genes agree in direction, with ten unmatched genes explicitly unassessed. A recovered hamster indicator table has strongly opposite directions and remains flagged for review.', '', '## Evidence and reproduction', '', '- [Internal QC replay, source-conservation and per-dataset findings](../../internal-qc/advancement-2026-09-05/ADVANCEMENT_REPORT.md)', '- [28 existing comparison reviews and independent source review](../../author-validation/continued-sources/advancement-comparisons-2026-09-05/README.md)', '- [Author-source group A: 58 records](../../author-validation/continued-sources/advancement-sources-a-2026-09-05/README.md)', '- [Author-source group B: 58 records](../../author-validation/continued-sources/advancement-sources-b-2026-09-05/README.md)', '- [Every changed check, remaining blocker, scope and next step](./advancement-report.json)', '- [Build, test, browser and checkout-byte validation](./VALIDATION.md)', '', 'Regenerate author comparisons with `npx tsx scripts/compare_author_results.mts`, then `npx tsx scripts/build_author_validation.mts`, `npm run build:quality`, and `npx tsx scripts/build_verification_advancement.mts`. Verify the shared artifacts with `npm run check:author-validation`, `npm run check:quality`, and `npm run check:verification-advancement`. Source extraction and runtime replay commands are recorded in their linked reports. Current source, normalized-table and script hashes are checked before evidence is reused.', '', 'This is a cumulative report for the original baseline corpus. Later verification rounds are included in current totals; new intake is excluded. The completed second-round result is preserved separately by its immutable input snapshot.', '', '## All dataset outcomes', '', '| Dataset | Internal QC before → after | Author concordance before → after | Remaining author task |', '|---|---|---|---|', ...records.map(row => `| ${clean(row.accession || row.datasetId)} | ${row.before.internalQc} → ${row.after.internalQc} | ${row.before.authorConcordance} → ${row.after.authorConcordance} | ${clean(row.authorNextStep)} |`), ''].join('\n');
const outputs = { 'advancement-report.json': `${JSON.stringify({ schemaVersion: 1, date: '2026-09-05', summary, dependencies, replayEvidencePath: 'data/internal-qc/advancement-2026-09-05/normalization-evidence.json', replaySchemaVersion: replay.schemaVersion, records }, null, 2)}\n`, 'ADVANCEMENT_REPORT.md': md };
for (const [name, body] of Object.entries(outputs)) {
  const path = `${folder}/${name}`;
  if (process.argv.includes('--check')) {
    if (readFileSync(path, 'utf8') !== body) throw new Error(`Stale verification advancement report: ${path}`);
  } else writeFileSync(path, body);
}
console.log(JSON.stringify(summary));
