// Download the GTEx, HPA and Allen Human Brain reference atlases the Expression
// survey shows beside the study data.
//
// They are generated by build:expression-external from source downloads this
// repository does not carry (GTEx and Allen are large and carry their own terms),
// and the app loads them same-origin from /expression/<provider>/. This mirrors
// the deployed copies from the app host: about 8,200 small JSON files, 230 MB in
// total. Without them the survey reports those three collections as unavailable
// and everything else works.
//
//   pnpm run fetch:expression
//   HYPOEXPLORER_APP_ORIGIN=https://... pnpm run fetch:expression

import { mkdirSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const app = (process.env.HYPOEXPLORER_APP_ORIGIN || 'https://hypoexplorer.com').replace(/\/+$/, '');
const PROVIDERS = ['gtex', 'hpa', 'allen-human'];
const CONCURRENCY = 16;

async function fetchBytes(relative: string): Promise<Buffer> {
  for (let attempt = 1; ; attempt++) {
    const response = await fetch(`${app}/expression/${relative}`);
    if (response.ok) return Buffer.from(await response.arrayBuffer());
    if (attempt === 3 || response.status < 500) throw new Error(`${app}/expression/${relative}: HTTP ${response.status}`);
  }
}

function save(relative: string, bytes: Buffer): void {
  const target = path.join(ROOT, 'public/expression', relative);
  mkdirSync(path.dirname(target), { recursive: true });
  writeFileSync(target, bytes);
}

for (const provider of PROVIDERS) {
  const manifestBytes = await fetchBytes(`${provider}/manifest.json`);
  const manifest = JSON.parse(manifestBytes.toString('utf8'));
  const shard = (prefix: string, i: number) => `${prefix}${String(i).padStart(4, '0')}.json`;
  const files = [
    manifest.validationPath ? `${provider}/${manifest.validationPath}` : `${provider}/validation.json`,
    ...Array.from({ length: manifest.lookupShardCount }, (_, i) => `${provider}/lookup/${shard('l', i)}`),
    ...Array.from({ length: manifest.valueShardCount }, (_, i) => `${provider}/values/${shard('v', i)}`),
  ];
  let next = 0;
  let bytes = manifestBytes.length;
  await Promise.all(Array.from({ length: CONCURRENCY }, async () => {
    while (next < files.length) {
      const file = files[next++];
      const body = await fetchBytes(file);
      bytes += body.length;
      save(file, body);
    }
  }));
  // The manifest goes last, so an interrupted run never looks complete.
  save(`${provider}/manifest.json`, manifestBytes);
  console.log(`public/expression/${provider}: ${files.length + 1} files, ${(bytes / 1e6).toFixed(1)} MB`);
}
