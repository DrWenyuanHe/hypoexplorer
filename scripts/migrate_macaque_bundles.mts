// Relocate the macaque snRNA data onto the multi-dataset bundle layout.
//
// Reads the legacy public/pop_meta.js (POP_META) and each public/pop_<id>.js
// (POP_<ID>) and writes dataset-namespaced bundles under
//   public/datasets/macaque_snrna/
// preserving de/cpm/pathways/qc VERBATIM and extending each track's meta with
//   meta.sampleOrder  = meta.sampleNames
//   meta.groupSamples = { normal: meta.normalSamples, obese: meta.obeseSamples }
//
// Run:  node scripts/migrate_macaque_bundles.mjs
// Then: node scripts/verify_macaque_equivalence.mjs

import fs from 'node:fs';
import path from 'node:path';
import vm from 'node:vm';
import { fileURLToPath } from 'node:url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const REPO_ROOT = path.resolve(__dirname, '..');
const PUBLIC_DIR = path.join(REPO_ROOT, 'public');
const OUT_DIR = path.join(PUBLIC_DIR, 'datasets', 'macaque_snrna');

// Load a legacy bundle file in an isolated VM context and return the single
// global it assigns (POP_META, QC_GLOBAL, POP_<ID>, ...).
function loadGlobal(file, expectedKey) {
  const src = fs.readFileSync(file, 'utf8');
  const ctx = {};
  vm.createContext(ctx);
  vm.runInContext(src, ctx, { filename: file });
  if (expectedKey) {
    if (!(expectedKey in ctx)) {
      throw new Error(`${path.basename(file)} did not define global ${expectedKey}`);
    }
    return ctx[expectedKey];
  }
  const keys = Object.keys(ctx);
  if (keys.length !== 1) {
    throw new Error(`${path.basename(file)} defined ${keys.length} globals (expected 1): ${keys.join(', ')}`);
  }
  return ctx[keys[0]];
}

function writeGlobalFile(file, globalKey, obj, header) {
  const body = `${header}\nvar ${globalKey} = ${JSON.stringify(obj)};\n`;
  fs.writeFileSync(file, body);
}

function main() {
  // --- load legacy meta ---
  const metaFile = path.join(PUBLIC_DIR, 'pop_meta.js');
  const popMeta = loadGlobal(metaFile, 'POP_META');
  const populations = popMeta.populations;
  if (!Array.isArray(populations) || populations.length === 0) {
    throw new Error('POP_META.populations is empty or not an array');
  }

  fs.mkdirSync(OUT_DIR, { recursive: true });

  // --- dataset meta.js ---
  writeGlobalFile(
    path.join(OUT_DIR, 'meta.js'),
    'HX_MACAQUE_SNRNA_META',
    popMeta,
    '// AUTO-GENERATED by scripts/migrate_macaque_bundles.mjs — do not edit\n// macaque_snrna dataset meta (verbatim copy of legacy POP_META)',
  );

  // --- dataset qc_global.js ---
  const qcFile = path.join(PUBLIC_DIR, 'qc_global.js');
  const qcGlobal = loadGlobal(qcFile, 'QC_GLOBAL');
  writeGlobalFile(
    path.join(OUT_DIR, 'qc_global.js'),
    'HX_MACAQUE_SNRNA_QC',
    qcGlobal,
    '// AUTO-GENERATED by scripts/migrate_macaque_bundles.mjs — do not edit\n// macaque_snrna dataset-level QC (verbatim copy of legacy QC_GLOBAL)',
  );

  // --- per-track bundles ---
  let written = 0;
  const missing = [];
  for (const id of populations) {
    const srcFile = path.join(PUBLIC_DIR, `pop_${id}.js`);
    if (!fs.existsSync(srcFile)) {
      missing.push(id);
      continue;
    }
    const oldGlobalKey = `POP_${id.toUpperCase()}`;
    const raw = loadGlobal(srcFile, oldGlobalKey);

    // Clone so we never mutate the loaded object; de/cpm/pathways/qc stay verbatim.
    const out = { ...raw };
    const meta = { ...raw.meta };
    meta.sampleOrder = meta.sampleNames;
    meta.groupSamples = { normal: meta.normalSamples, obese: meta.obeseSamples };
    out.meta = meta;

    const newGlobalKey = `HX_MACAQUE_SNRNA_${id.toUpperCase()}`;
    writeGlobalFile(
      path.join(OUT_DIR, `track_${id}.js`),
      newGlobalKey,
      out,
      `// AUTO-GENERATED by scripts/migrate_macaque_bundles.mjs — do not edit\n// macaque_snrna track: ${id}`,
    );
    written += 1;
  }

  if (missing.length) {
    throw new Error(`Missing legacy bundle file(s) for: ${missing.join(', ')}`);
  }

  console.log('migrate_macaque_bundles: done');
  console.log(`  out dir:        ${path.relative(REPO_ROOT, OUT_DIR)}`);
  console.log('  meta.js:        written (HX_MACAQUE_SNRNA_META)');
  console.log('  qc_global.js:   written (HX_MACAQUE_SNRNA_QC)');
  console.log(`  track bundles:  ${written} / ${populations.length}`);
}

main();
