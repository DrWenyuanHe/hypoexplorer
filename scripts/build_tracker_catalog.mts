// Build-time generator for the dataset tracker.
//
// Reads the (git-tracked) survey catalog + the explorer's dataset registry,
// precomputes each candidate's integration status against the explorer, and bakes
// two artifacts that ship in the build:
//
//   public/tracker/catalog.js              — window.HX_TRACKER_CATALOG (lazy-loaded
//                                             blob; ~2 MB; cache-busted at load,
//                                             excluded from the PWA precache).
//   src/data/tracker/reverseIndex.generated.js — TRACKER_REVERSE_INDEX, a tiny eager
//                                             map (explorer datasetId -> candidate
//                                             accession) for explorer->tracker links.
//
// Run via `npm run build:tracker`; also runs automatically as `prebuild`.
// Deterministic from committed sources, so any clone/CI regenerates identically.

import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { DATASETS } from '../src/data/datasets';
import { buildRegistry, integrationFor, trimRecord } from './lib/trackerIntegration.mjs';

const here = path.dirname(fileURLToPath(import.meta.url));
const ROOT = path.resolve(here, '..');
const CATALOG = path.join(ROOT, 'nar-research/dataset-survey/scout_master_combined.json');
const SIDECAR = path.join(ROOT, 'src/data/tracker/explorerAccessions.json');
const OUT_BLOB = path.join(ROOT, 'public/tracker/catalog.js');
const OUT_INDEX = path.join(ROOT, 'src/data/tracker/reverseIndex.generated.js');

const master = JSON.parse(readFileSync(CATALOG, 'utf8'));
let sidecar = {};
try {
  sidecar = JSON.parse(readFileSync(SIDECAR, 'utf8'));
} catch (_e) {
  /* sidecar optional */
}

const registry = buildRegistry(DATASETS, sidecar);

const rows = (master.confirmed || []).map((r) => {
  const row: any = trimRecord(r);
  const m = integrationFor(r, registry);
  row.match = m || null;
  row.integrated = !!(m && m.tier === 'dataset');
  row.related = !!(m && m.tier === 'publication');
  return row;
});

// The explorer registry summary — powers the in-app "Currently in HypoExplorer"
// reference panel without needing a live registry at runtime.
const explorer = registry.map((d) => ({
  id: d.id,
  name: d.name,
  organism: d.organism,
  modality: d.modality,
  geo: d.geo,
  doi: d.doi,
  accessions: d.accessions,
}));

const integratedCount = rows.filter((r) => r.integrated).length;
const relatedCount = rows.filter((r) => r.related).length;

// Reverse index: explorer datasetId -> the survey candidate accession that IS that
// dataset (only populated for tier 'dataset' matches; empty until a candidate is
// integrated). Used by Data Sources cards to deep-link into the matching dossier.
const reverse = {};
for (const r of rows) {
  if (r.integrated && r.match) reverse[r.match.id] = r.acc;
}

const payload = {
  rows,
  explorer,
  count: rows.length,
  integratedCount,
  relatedCount,
  generatedFrom: 'nar-research/dataset-survey/scout_master_combined.json',
};

const banner = '// AUTO-GENERATED by scripts/build_tracker_catalog.mts — do not edit by hand.\n';
mkdirSync(path.dirname(OUT_BLOB), { recursive: true });
mkdirSync(path.dirname(OUT_INDEX), { recursive: true });
// Defense-in-depth: the catalog ships LLM-regenerated survey prose embedded in a
// JS file. It loads as an external <script src>, so a stray </script> in the prose
// cannot break out the way it would inline — but escape `<` anyway to future-proof
// against ever inlining the blob. Transparent: < evaluates back to '<' at runtime.
const blobJson = JSON.stringify(payload).replace(/</g, '\\u003c');
writeFileSync(OUT_BLOB, `${banner}window.HX_TRACKER_CATALOG = ${blobJson};\n`);
writeFileSync(
  OUT_INDEX,
  banner +
    '// Maps an explorer dataset id -> the survey candidate accession that IS that\n' +
    '// dataset (empty until a candidate is integrated). Drives explorer->tracker links.\n' +
    'export const TRACKER_REVERSE_INDEX = ' +
    JSON.stringify(reverse, null, 2) +
    ';\n',
);

const mb = (JSON.stringify(payload).length / 1024 / 1024).toFixed(2);
console.log(
  `tracker catalog: ${rows.length} rows · ${integratedCount} integrated · ${relatedCount} related`,
);
console.log(
  `reverse index: ${Object.keys(reverse).length} entr${Object.keys(reverse).length === 1 ? 'y' : 'ies'}`,
);
console.log(
  `wrote public/tracker/catalog.js (${mb} MB) + src/data/tracker/reverseIndex.generated.js`,
);
