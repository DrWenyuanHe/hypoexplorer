# Cache policy for the app shell on Cloudflare Workers static assets.
#
# This is the port of public/.htaccess's Cache-Control block, which only Apache
# (Hostinger) reads. Keep the two in step for as long as both hosts are live.
#
# WHAT IS NOT HERE, AND WHY
# -------------------------
# Compression. The .htaccess file also hand-rolls brotli/gzip sidecar serving
# (rewrite to <file>.br, force Content-Encoding, append Vary) because LiteSpeed
# size-caps on-the-fly compression. Cloudflare compresses at the edge on its own,
# so those rules have no equivalent and need none — and the .br/.gz sidecars are
# excluded from the upload entirely (see .assetsignore).
#
# Everything not matched below inherits Cloudflare's default for static assets,
# `public, max-age=0, must-revalidate` plus an ETag. That is already the right
# policy for the unhashed-but-?v=-busted files (pop_meta.js, tracker/catalog.js,
# nomenclature/aliases.js, nomenclature/table.js): .htaccess sets exactly that
# for them today, deliberately NOT immutable, because their filenames never
# change. The ETag makes the revalidation a 304 rather than a re-download.

# Vite content-hashes these filenames, so the bytes behind a given name can
# never change. The one path class that is safe to freeze.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell itself. Must revalidate or a cached copy pins visitors to an old
# build — the failure the version stamp below exists to detect.
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

# Service worker and manifest: a stale worker outlives deploys and keeps serving
# a precached shell, which is precisely the wedged state that needs an escape.
/sw.js
  Cache-Control: no-cache, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

# The deploy's version stamp (src/pwa/versionWatch.ts polls it). A cached copy
# reports the PREVIOUS deploy's number, which is the staleness it exists to
# catch, so this one must never be served from cache.
/version.json
  Cache-Control: no-cache, must-revalidate

/release.json
  Cache-Control: no-cache, must-revalidate
