{
  "compilerOptions": {
    "target": "ES2022",
    // WebWorker supplies fetch/Response/console; src/env.ts hand-types the
    // bindings and the scheduled controller, so no generated types are needed.
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
