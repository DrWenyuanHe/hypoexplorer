data/author-validation/continued-sources/GSE190389_TMM_workbook.xlsx

# External reference expression products: BUILD ARTIFACTS (~100 MB for GTEx),
# regenerated from data/expression/{gtex,hpa,allen-human}/ by scripts/build_*_reference.mts.
# The builders verify the retained source hashes and replay every emitted value.
public/expression/gtex/
public/expression/hpa/
public/expression/allen-human/

# Wrangler local state (Cloudflare Workers deploys)
.wrangler
# Runtime + binding types regenerated per Worker by `wrangler types`
workers/*/worker-configuration.d.ts

# Large duplicate supplementary archives retained locally. Extracted comparison
# tables remain trackable; final-numerical-batch manifests pin archive URLs/hash.
data/author-validation/continued-sources/final-numerical-batch-a/GSE189945/europepmc_supplements.zip
data/author-validation/continued-sources/final-numerical-batch-d/PMC12461651_supplements.zip

# Python importer bytecode is local runtime cache.
__pycache__/

# Local production preview for the third verification audit.
/dist-verification-round3/

# Bulk GEO/SRA download cache from the 2026-09-05 dataset-survey sweep
# (~36k soft/supplementary files). Re-fetchable from the accessions recorded
# in the tracked dataset-survey tables; never part of the repo's evidence set.
nar-research/dataset-survey/browser-routes-2026-09-05/

# ---- Bulk re-fetchable source data (see the R2 + Zenodo storage plan) ----
# Original archives, their extractions, and pinned R annotation runtimes for the
# 2026-09-05 source-authenticity and replication rounds. Every file is recorded in
# the round evidence JSONs by source URL, SHA-256 and byte count — that pin is the
# provenance record; these bytes are re-downloadable or re-derivable from it.
# Together they exceed 9 GB and include six files past GitHub's 100 MB file limit,
# so they cannot live in git. The audit scripts re-fetch and re-extract them.
data/internal-qc/**/downloads/
data/internal-qc/**/extracted-source/
data/internal-qc/**/runtime/
data/internal-qc/**/region-code/

# Raw archives for the September 5 discovery intake (up to 739 MB each). The
# analyzed outputs, sample sheets and manifests under the same datasets stay tracked.
geo_replication/datasets/*_discovery_20260905/raw/

# Deferred GSE203125 platform annotation download (513 MB). Its source and
# exact bytes are pinned in data/quality/hfd-intake-2026-09-12/GSE203125-deferred.json.
geo_replication/datasets/GSE203125_mmus_vmh_hfd_array/metadata/GPL20775.soft

# Working design document, not shipped code: it is a scratch comparison of study
# card layouts kept beside the repo, and it is a root .html so it would otherwise
# enter the agent-context source snapshot.
card-redesigns.html

# GSE205313 raw inputs for the R 4.6.0 unrounded preparation (scripts/regen-r460/prep_GSE205313_r460.R).
# Re-fetchable; URL, bytes and sha256 are recorded in the dataset metadata/r460_sources.json.
geo_replication/datasets/GSE205313_mmus_hypo_astrocyte_hfhs/raw/GSE205313_RAW.tar
geo_replication/datasets/GSE205313_mmus_hypo_astrocyte_hfhs/raw/Mus_musculus.GRCm38.102.gtf.gz

# R 4.6.0 regeneration: raw-library-size CPM is written by the r460 drivers but not published
# (the explorer shows TMM-normalized CPM). Copies are kept in the frozen staging archive.
geo_replication/**/*_CPM_raw.tsv.gz
data/raw/results/*/de/rawcpm.csv

