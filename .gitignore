node_modules/
dist/
*.local

# Credentials. `*.local` above already covers .env.local, but NOT a plain .env —
# which is exactly where wrangler looks for CLOUDFLARE_API_TOKEN (it is the
# persistence method Cloudflare's own docs recommend), so an unignored .env is a
# token one `git add -A` away from the history. .dev.vars is wrangler's other
# secret file. .env.example carries no secrets and stays tracked.
.env*
.dev.vars*
!.env.example
!.env.development
!.env.production
!.env.offline
# Also tracked, and also secret-free BY CONSTRUCTION: an empty file whose only
# job is to stop `wrangler deploy` auto-loading .env.local. See the file itself.
!.env.cfdeploy

# Cross-dataset query index — a BUILD ARTIFACT, regenerated from public/datasets/
# by scripts/build_query_index.mts (verify with --check).
#
# Deliberately not tracked. Shards are published under an immutable
# public/query/<buildId>/ prefix, so every rebuild writes a whole new directory:
# committing it would add ~61 MB of fresh blobs to history on each data change,
# on top of the 385 MB public/datasets/ already carries.
#
# It must still be UPLOADED with the bundles — `pnpm run upload:bundles` covers
# both trees and refuses to publish datasets without it, because a missing index
# silently drops the app back to downloading ~284 MB per cross-dataset query.
#
# To track it anyway: `git add -f public/query`.
public/query/
public/tracker/catalog.js
# Private public-safety rules (personal identifiers); see scripts/lib/publicSafety.mts.
.public-safety.local.json
.gstack/
.claude/scheduled_tasks.lock
.claude/*.lock

.design-audit/

# Writing (documents, slide decks) and generated figures stay out of this repository.
*.docx
*.pptx
geo_replication/**/*.md
geo_replication/figures/
Rplots.pdf

# MGI Ensembl->symbol source download (16MB); the derived scripts/lib/mmus_ens2sym.json is committed
scripts/lib/MRK_ENSEMBL.rpt

# Nomenclature authority downloads (HGNC, MGI, RGD and species-specific NCBI
# gene_info files), re-fetchable with
# `pnpm run build:nomenclature --fetch`. The derived data/nomenclature/*.tsv
# and public/nomenclature/*.js ARE committed — see scripts/build_nomenclature.mts
# on why that table is source rather than a build artifact.
scripts/lib/nomenclature-cache/

# GSE281503 (daridorexant/LPS; explorer dataset mouse_hypo_lps_gse281503): the
# raw GEO supplement is a 95 MB multi-sheet DEG workbook, re-downloadable from
# https://ftp.ncbi.nlm.nih.gov/geo/series/GSE281nnn/GSE281503/suppl/ (bytes and
# SHA-256 pinned in scripts/prep_GSE281503.py and metadata/GSE281503_source_files.tsv).
# Only that workbook stays out of Git; the processed tables and small metadata
# are tracked like every other geo_replication dataset. When it is absent the
# author-validation checks carry the committed GSE281503 records forward with a
# warning (scripts/lib/authorValidationAudit.mts, LOCAL_INPUT_DATASETS).
geo_replication/datasets/GSE281503_mmus_hypo_lps/raw/GSE281503_Effects_of_daridorexant_on_LPS-induced_mice.xlsx

# Codex CLI session scratch (tool artifact, not project content)
.context/

# Pipeline scratch (xlsx reads, matrix batches) — tool artifacts, not project content
.tmp/

# Agent export archives (pnpm run build:agent-export)
/dist-export/

# Local research, report and validation deliverables (~13 GB, includes copied
# software environments) — working output, not project content
/output/

# Isolated verification build output (avoids a locked shared dist directory)
.verification-build-*/

# Large author expression workbook retained locally; official URL and SHA-256
