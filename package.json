{
  "name": "e9-explorer",
  "version": "0.15.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build:brand": "tsx scripts/build_brand_assets.mts",
    "dev": "vite",
    "context:generate": "node scripts/agent-context/cli.mjs generate",
    "context:review": "node scripts/agent-context/cli.mjs review",
    "context:check": "node scripts/agent-context/cli.mjs check",
    "context:install-hook": "node scripts/agent-context/install-hook.mjs",
    "test:context": "node --test scripts/agent-context/__tests__/context.test.mjs",
    "build:expression-reference": "tsx scripts/build_oxt_reference.mts",
    "check:expression-reference": "tsx scripts/build_oxt_reference.mts --check",
    "build:expression-external": "tsx scripts/build_gtex_reference.mts && tsx scripts/build_hpa_reference.mts && tsx scripts/build_allen_human_reference.mts",
    "check:expression-external": "tsx scripts/build_gtex_reference.mts --check && tsx scripts/build_hpa_reference.mts --check && tsx scripts/build_allen_human_reference.mts --check",
    "build:oxt-avp": "tsx scripts/build_oxt_avp_bundles_r460.mts && tsx scripts/audit_oxt_avp_intake_r460.mts",
    "check:oxt-avp": "tsx scripts/build_oxt_avp_bundles_r460.mts --check && tsx scripts/audit_oxt_avp_intake_r460.mts --check",
    "build:quality": "tsx scripts/build_internal_qc_r460.mts && tsx scripts/build_quality_report_r460.mts",
    "validate:author:gse285906": "Rscript scripts/validate_GSE285906_author.R",
    "validate:author:gse234483": "Rscript scripts/validate_GSE234483_author.R",
    "check:author-validation": "python scripts/prepare_author_round2.py --check && tsx scripts/compare_author_results.mts --check && tsx scripts/audit_author_validation.mts --check && tsx scripts/audit_fgsea_migration.mts --check && tsx scripts/refresh_fgsea_bundles.mts --check && tsx scripts/build_author_validation.mts --check --require-complete && tsx scripts/audit_author_advancement_2026_09_05.mts --check",
    "check:intake": "tsx scripts/audit_september5_intake_current.mts --check",
    "check:query-index": "tsx scripts/build_query_index.mts --check",
    "build:query-index": "tsx scripts/build_query_index.mts",
    "check:upstream": "tsx scripts/build_upstream_processing.mts --check",
    "build": "vite build",
    "precompress": "tsx scripts/precompress_dist.mts",
    "deploy:dist": "pnpm run build && pnpm run precompress",
    "verify:deploy": "tsx scripts/verify_deploy.mts",
    "verify:release": "tsx scripts/verify_release.mts",
    "prepare:publication": "tsx scripts/prepare_publication_release.mts",
    "build:agent-export": "node --max-old-space-size=6144 ./node_modules/tsx/dist/cli.mjs scripts/build_agent_export.mts",
    "prepare:deploy": "tsx scripts/prepare_deploy.mts",
    "deploy:cf": "pnpm run prepare:deploy && pnpm run deploy:dist && pnpm run verify:release && wrangler deploy --env-file .env.cfdeploy && pnpm run verify:deploy",
    "deploy:cf:dry": "pnpm run prepare:deploy && pnpm run deploy:dist && pnpm run verify:release && wrangler deploy --dry-run",
    "optimize:bundles": "tsx scripts/optimize_bundles.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && pnpm run typecheck:guard",
    "typecheck:app": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck:guard": "tsc -p workers/spend-guard/tsconfig.json",
    "guard:deploy": "wrangler deploy --config workers/spend-guard/wrangler.jsonc --env-file .env.cfdeploy",
    "guard:dev": "wrangler dev --config workers/spend-guard/wrangler.jsonc --env-file .env.cfdeploy --test-scheduled --port 8791 --var GUARD_MODE:observe",
    "edge:apply": "tsx scripts/apply_edge_rules.mts",
    "verify:edge": "tsx scripts/verify_edge.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test --config scripts/smoke/playwright.config.ts",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "deadcode": "knip",
    "upload:bundles": "tsx scripts/upload_bundles_r2.mts",
    "build:timeseries": "tsx scripts/build_timeseries_bundles.mts",
    "build:normalized": "tsx scripts/build_normalized_bundles.mts",
    "build:nomenclature": "node --max-old-space-size=6144 ./node_modules/tsx/dist/cli.mjs scripts/build_nomenclature.mts",
    "build:search-names": "tsx scripts/build_search_names.mts",
    "check:hfd-intake": "python scripts/compare_hfd_authors.py --check && tsx scripts/audit_hfd_intake_r460.mts --check && tsx --test scripts/lib/historicalEvidence.test.mts scripts/lib/hfdReplayValidation.test.mts",
    "analyze:hfd": "Rscript scripts/run_hfd_pipeline.R && Rscript scripts/run_mouse_fgsea.R GSE104709 GSE107324_male GSE107324_female",
    "build:hfd-bundles": "tsx scripts/build_hfd_bundles_r460.mts",
    "build:expression-index": "tsx scripts/build_expression_index.mts",
    "check:expression-index": "tsx scripts/build_expression_index.mts --check",
    "check:bundle-eol": "tsx --test scripts/lib/bundleEol.test.mts && tsx scripts/check_bundle_eol.mts",
    "restore:bundle-eol": "tsx scripts/check_bundle_eol.mts --fix",
    "fetch:query": "tsx scripts/fetch_query_catalog.mts",
    "fetch:hypomap": "tsx scripts/fetch_hypomap.mts",
    "fetch:expression": "tsx scripts/fetch_expression_references.mts",
    "fetch:data": "node --max-old-space-size=6144 ./node_modules/tsx/dist/cli.mjs scripts/fetch_data.mts",
    "data:offline": "pnpm run fetch:data --no-matrices && pnpm run build:query-index && pnpm run build:expression-index",
    "dev:offline": "node scripts/dev_offline.mjs",
    "check:public-safety": "tsx scripts/check_public_safety.mts",
    "hooks:install": "node scripts/install_safety_hook.mjs"
  },
  "dependencies": {
    "html2canvas": "^1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "knip": "^6.44.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.159.0"
  },
  "engines": {
    "node": ">=22"
  }
}
