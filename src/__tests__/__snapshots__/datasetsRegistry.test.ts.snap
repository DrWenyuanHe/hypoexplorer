  {
    "bundleBaseUrl": "",
    "bundleFileTemplate": "/datasets/mouse_hypo_fasting_gse87544/track_{trackId}.js",
    "category": "Feeding & fasting",
    "citation": "Adult mouse whole-hypothalamus Drop-seq, 17 technical partitions (18,300 cells) resolved to seven author-defined processed units, normal fed n=4 (B0_Normal, B1_Normal, B2_Normal, B3_Normal) vs 24-hour food deprived n=3 (B1_Hungry, B2_Hungry2, B4_Hungry2), with sequencing batch modeled; one residual degree of freedom, so the comparison is exploratory: effect sizes and pathway ranks, no gene-level FDR calls (Chen et al., Cell Rep 2017, PMID 28355573; GSE87544)",
    "contrasts": [
      {
        "baseline": "control",
        "case": "case",
        "description": "Exploratory comparison: read effect sizes (logFC) and pathway ranks, not gene-level significance. The edgeR-QL fit models sequencing batch (~ batch + group) on seven processed units, 4 fed vs 3 food-deprived, which leaves one residual degree of freedom; its gene-level p-values and FDR depend on the edgeR version far more than on the data, so no gene-level FDR call is made for this dataset.",
        "exploratory": true,
        "id": "deprived_vs_fed",
        "isDefault": true,
      },
    ],
